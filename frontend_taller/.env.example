# Portable: copiar a .env y rellenar con el proyecto Firebase/GCP destino.
# No commitear .env con secretos reales.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL de Cloud Run (terraform output service_url)
VITE_API_BASE_URL=

# OAuth Web Client ID (público) — IdP Google de Firebase / Cloud Console
VITE_GOOGLE_OAUTH_CLIENT_ID=
